{
  "name": "PS5-Xbox-Hybrid",
  "display_name": "PS5 x Xbox Hybrid",
  "author": "Zero",
  "version": "v1.0.0",
  "manifest_version": 9,
  "target": "System-Wide",
  "description": "System-wide console-style theme: PS5 motion and spotlight focus blended with Xbox tile geometry and green accents. Style presets plus fine-grained options.",
  "inject": {
    "css/core/vars.css": [
      "SP",
      "QuickAccess",
      "MainMenu"
    ],
    "css/core/background.css": [
      "SP"
    ],
    "css/core/panels.css": [
      "QuickAccess",
      "MainMenu"
    ],
    "css/core/tabs.css": [
      "SP"
    ],
    "css/home/tiles.css": [
      "SP"
    ]
  },
  "patches": {
